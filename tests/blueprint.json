{
  "$schema": "https://playground.wordpress.net/blueprint-schema.json",
  "preferredVersions": {
    "php": "8.3",
    "wp": "6.8.8"
  },
  "steps": [
    {
      "step": "defineWpConfigConsts",
      "consts": {
        "WP_AUTO_UPDATE_CORE": false,
        "AUTOMATIC_UPDATER_DISABLED": true,
        "DISABLE_WP_CRON": true
      }
    },
    {
      "step": "installPlugin",
      "pluginData": {
        "resource": "url",
        "url": "https://downloads.wordpress.org/plugin/elementor.4.2.4.zip"
      },
      "options": {
        "activate": true
      }
    },
    {
      "step": "installTheme",
      "themeData": {
        "resource": "url",
        "url": "https://downloads.wordpress.org/theme/hello-elementor.3.5.1.zip"
      },
      "options": {
        "activate": true
      }
    },
    {
      "step": "activatePlugin",
      "pluginPath": "property-slider-free/property-slider-free.php"
    },
    {
      "step": "runPHP",
      "code": "<?php require '/wordpress/wp-load.php'; require '/wordpress/wp-content/plugins/property-slider-free/tests/seed.php';"
    }
  ]
}
